# ============================================================
# SECTION 39: PATIENT DIGITAL TWIN
# ============================================================

class PatientDigitalTwin:

    def __init__(
        self,
        patient_id,
        baseline_state=None
    ):

        self.patient_id = patient_id

        self.baseline_state = (
            baseline_state
            if baseline_state
            else None
        )

        self.previous_state = None
        self.current_state = None

        self.history = []

    # --------------------------------------------------------
    # Determine trend
    # --------------------------------------------------------

    def determine_trend(
        self,
        previous_score,
        current_score
    ):

        if previous_score is None:
            return "STABLE"

        difference = (
            current_score
            - previous_score
        )

        # Prototype threshold.
        # Not clinically validated.

        if difference > 0.05:
            return "DETERIORATING"

        elif difference < -0.05:
            return "IMPROVING"

        else:
            return "STABLE"

    # --------------------------------------------------------
    # Update twin
    # --------------------------------------------------------

    def update(
        self,
        prediction,
        timestamp=None
    ):

        if timestamp is None:

            timestamp = datetime.utcnow().isoformat()

        previous = self.current_state

        current = {
            "risk_score": prediction["risk_score"],
            "risk_level": prediction["risk_level"],
            "predicted_state": prediction[
                "predicted_state"
            ],
            "timestamp": timestamp
        }

        previous_score = (
            previous["risk_score"]
            if previous
            else None
        )

        trend = self.determine_trend(
            previous_score,
            current["risk_score"]
        )

        self.previous_state = previous

        self.current_state = current

        self.history.append(
            {
                "timestamp": timestamp,
                "state": current.copy()
            }
        )

        return {
            "patient_id": self.patient_id,

            "previous_state": previous,

            "current_state": current,

            "trend": trend
        }

    # --------------------------------------------------------
    # Get complete twin
    # --------------------------------------------------------

    def get_state(self):

        previous_score = (
            self.previous_state["risk_score"]
            if self.previous_state
            else None
        )

        current_score = (
            self.current_state["risk_score"]
            if self.current_state
            else None
        )

        if current_score is not None:

            trend = self.determine_trend(
                previous_score,
                current_score
            )

        else:

            trend = "STABLE"

        return {
            "patient_id": self.patient_id,
            "baseline_state": self.baseline_state,
            "previous_state": self.previous_state,
            "current_state": self.current_state,
            "trend": trend,
            "history_length": len(self.history)
        }



# ============================================================

# Patient_ID identifies the patient but has no useful
# clinical meaning.
#
# Health_Camp_ID identifies the particular camp.
# We don't want the model memorizing camp IDs.
#
# Health_Score is the target itself and has already been removed.
#
# Registration_Date / First_Interaction can potentially be
# transformed into useful temporal features later, but raw
# dates should not be passed directly to the model.

REMOVE_COLUMNS = [
    "Patient_ID",
    "Health_Camp_ID"
]

X = X.drop(
    columns=REMOVE_COLUMNS,
    errors="ignore"
)

print("Removed:")
for col in REMOVE_COLUMNS:
    print(" -", col)

print("\nRemaining features:")
print(X.columns.tolist())


# ============================================================
# SECTION 15: DATE FEATURE ENGINEERING
# ============================================================

date_columns = [
    "Registration_Date",
    "First_Interaction"
]

for col in date_columns:

    if col in X.columns:

        X[col] = pd.to_datetime(
            X[col],
            errors="coerce"
        )

        # Extract useful temporal information
        X[f"{col}_year"] = (
            X[col].dt.year
        )

        X[f"{col}_month"] = (
            X[col].dt.month
        )

        X[f"{col}_dayofweek"] = (
            X[col].dt.dayofweek
        )

        # Remove original date
        X = X.drop(
            columns=[col]
        )

print("Date feature engineering complete.")

print("\nFinal features:")
print(X.columns.tolist())



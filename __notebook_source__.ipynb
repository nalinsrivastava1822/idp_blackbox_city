def evaluate_model(
    model,
    X_eval,
    y_eval,
    model_name
):

    predictions = model.predict(X_eval)

    probabilities = None

    if hasattr(model, "predict_proba"):
        probabilities = model.predict_proba(
            X_eval
        )

    accuracy = accuracy_score(
        y_eval,
        predictions
    )

    precision = precision_score(
        y_eval,
        predictions,
        average="weighted",
        zero_division=0
    )

    recall = recall_score(
        y_eval,
        predictions,
        average="weighted",
        zero_division=0
    )

    f1 = f1_score(
        y_eval,
        predictions,
        average="weighted",
        zero_division=0
    )

    # ROC-AUC
    roc_auc = None

    if probabilities is not None:

        try:

            if len(classes) == 2:

                roc_auc = roc_auc_score(
                    y_eval,
                    probabilities[:, 1]
                )

            else:

                roc_auc = roc_auc_score(
                    y_eval,
                    probabilities,
                    multi_class="ovr",
                    average="weighted"
                )

        except Exception:
            roc_auc = None

    print("\n" + "=" * 80)
    print(model_name)
    print("=" * 80)

    print(f"Accuracy : {accuracy:.4f}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall   : {recall:.4f}")
    print(f"F1       : {f1:.4f}")

    if roc_auc is not None:
        print(f"ROC-AUC  : {roc_auc:.4f}")

    print("\nClassification Report:")
    print(
        classification_report(
            y_eval,
            predictions,
            target_names=[
                str(c)
                for c in classes
            ],
            zero_division=0
        )
    )

    return {
        "model": model_name,
        "accuracy": accuracy,
        "precision": precision,
        "recall": recall,
        "f1": f1,
        "roc_auc": roc_auc
    }



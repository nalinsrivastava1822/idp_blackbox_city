def load_dataframe(path):
    """
    Load a supported tabular file into a pandas DataFrame.
    """
    
    suffix = path.suffix.lower()

    try:

        if suffix == ".csv":
            return pd.read_csv(path)

        elif suffix in [".xlsx", ".xls"]:
            return pd.read_excel(path)

        elif suffix == ".json":
            return pd.read_json(path)

        elif suffix == ".parquet":
            return pd.read_parquet(path)

        else:
            return None

    except Exception as e:
        print(f"[ERROR] Could not load {path}")
        print("Reason:", e)
        return None


datasets = {}

for path in files:

    df = load_dataframe(path)

    if df is not None:

        # Create unique dataset name
        dataset_name = str(path.relative_to(KAGGLE_INPUT_DIR))

        datasets[dataset_name] = df

        print(
            f"[LOADED] {dataset_name} "
            f"| rows={len(df):,} "
            f"| cols={len(df.columns)}"
        )

print(f"\nSuccessfully loaded {len(datasets)} datasets.")



TARGET_KEYWORDS = [
    "severity",
    "severity level",
    "risk",
    "risk level",
    "acuity",
    "triage",
    "outcome",
    "patient outcome",
    "test result",
    "test results",
    "result",
    "status",
    "condition severity",
    "mortality",
    "survival"
]


def find_target_candidates(df):

    candidates = []

    for col in df.columns:

        col_lower = str(col).strip().lower()

        score = 0

        for keyword in TARGET_KEYWORDS:

            if keyword in col_lower:
                score += 1

        if score > 0:

            candidates.append({
                "column": col,
                "score": score,
                "unique_values": df[col].nunique(dropna=True),
                "missing_pct": round(
                    df[col].isnull().mean() * 100,
                    2
                )
            })

    # IMPORTANT:
    # If there are no candidates, return an empty
    # dataframe WITH the expected columns.
    if not candidates:

        return pd.DataFrame(
            columns=[
                "column",
                "score",
                "unique_values",
                "missing_pct"
            ]
        )

    return pd.DataFrame(candidates).sort_values(
        "score",
        ascending=False
    )


for name, df in datasets.items():

    candidates = find_target_candidates(df)

    if len(candidates):

        print("\n" + "=" * 80)
        print(name)
        print("=" * 80)

        display(candidates)



]


def calculate_keyword_score(columns, keywords):

    score = 0

    for col in columns:

        col_lower = str(col).lower()

        for keyword in keywords:

            if keyword in col_lower:
                score += 1

    return score


dataset_analysis = []

for name, df in datasets.items():

    patient_score = calculate_keyword_score(
        df.columns,
        PATIENT_KEYWORDS
    )

    infrastructure_score = calculate_keyword_score(
        df.columns,
        INFRASTRUCTURE_KEYWORDS
    )

    medicine_score = calculate_keyword_score(
        df.columns,
        MEDICINE_KEYWORDS
    )

    text_score = calculate_keyword_score(
        df.columns,
        TEXT_KEYWORDS
    )

    scores = {
        "patient": patient_score,
        "infrastructure": infrastructure_score,
        "medicine": medicine_score,
        "text": text_score
    }

    predicted_type = max(
        scores,
        key=scores.get
    )

    dataset_analysis.append({
        "dataset": name,
        "rows": len(df),
        "columns": len(df.columns),
        "patient_score": patient_score,
        "infrastructure_score": infrastructure_score,
        "medicine_score": medicine_score,
        "text_score": text_score,
        "predicted_type": predicted_type
    })


dataset_analysis_df = pd.DataFrame(dataset_analysis)


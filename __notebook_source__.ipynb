def predict_patient(json_input):
    """
    Predict patient state from a JSON-compatible dictionary.

    The input fields must correspond to the actual features
    discovered during dataset inspection.

    patient_id is metadata and is NOT used as a model feature.
    """

    if not isinstance(json_input, dict):

        raise TypeError(
            "json_input must be a Python dictionary."
        )

    patient_id = json_input.get(
        "patient_id",
        "UNKNOWN"
    )

    # --------------------------------------------------------
    # Remove metadata fields
    # --------------------------------------------------------

    model_input = {
        key: value
        for key, value in json_input.items()
        if key not in [
            "patient_id",
            "timestamp",
            "stethoscope"
        ]
    }

    # --------------------------------------------------------
    # Convert list-valued fields into text
    # --------------------------------------------------------

    for key, value in model_input.items():

        if isinstance(value, list):

            model_input[key] = ", ".join(
                str(x)
                for x in value
            )

    # --------------------------------------------------------
    # Build dataframe using training features
    # --------------------------------------------------------

    input_df = pd.DataFrame(
        [model_input]
    )

    # Add missing model features
    for col in X.columns:

        if col not in input_df.columns:

            input_df[col] = np.nan

    # Keep only training features
    input_df = input_df[
        X.columns
    ]

    # --------------------------------------------------------
    # Prediction
    # --------------------------------------------------------

    prediction = FINAL_MODEL.predict(
        input_df
    )[0]

    probabilities = FINAL_MODEL.predict_proba(
        input_df
    )[0]

    predicted_state = label_encoder.inverse_transform(
        [prediction]
    )[0]

    risk_score = float(
        probabilities[prediction]
    )

    risk_level = probability_to_risk_level(
        risk_score
    )

    # --------------------------------------------------------
    # Prototype state
    # --------------------------------------------------------

    result = {
        "patient_id": patient_id,
        "risk_score": round(
            risk_score,
            4
        ),
        "risk_level": risk_level,
        "predicted_state": str(
            predicted_state
        ),
        "confidence": round(
            risk_score,
            4
        ),
        "target_definition": TARGET_DESCRIPTION,
        "clinical_warning": (
            "Prototype prediction only. "
            "Not a medical diagnosis."
        )
    }

    return result



# ============================================================
# SECTION 12: CREATE PROTOTYPE RISK CLASSES
# ============================================================
#
# IMPORTANT:
# These are NOT clinical thresholds.
#
# They are simply prototype bands based on the observed
# Health_Score distribution.
#
# We use quantiles rather than inventing medical thresholds.
# ============================================================

# Remove missing targets first
patient_data = patient_data.dropna(
    subset=[TARGET_COLUMN]
).copy()

# Calculate dataset-specific quantiles
q33 = patient_data[TARGET_COLUMN].quantile(0.33)
q66 = patient_data[TARGET_COLUMN].quantile(0.66)

print("33rd percentile:", q33)
print("66th percentile:", q66)


def assign_prototype_risk(score):

    if score <= q33:
        return "HIGH"

    elif score <= q66:
        return "MODERATE"

    else:
        return "LOW"


patient_data["Risk_Level"] = (
    patient_data[TARGET_COLUMN]
    .apply(assign_prototype_risk)
)

print("\nPrototype risk distribution:")

display(
    patient_data["Risk_Level"]
    .value_counts()
)

